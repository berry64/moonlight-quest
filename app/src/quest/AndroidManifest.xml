<?xml version="1.0" encoding="utf-8"?>
<!--
  Quest (Meta Horizon OS) manifest overlay. This is MERGED with src/main's manifest
  by the Android build; only VR-specific additions live here. The default 'mobile'
  flavor never sees any of this, so the phone/tablet/TV build is unchanged.

  The app still launches into the normal 2D PcView (from src/main). We only add an
  immersive VR activity (VrGameActivity) that is started when a stream begins, plus
  the Quest hardware feature/permission declarations required for a VR app.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:horizonos="http://schemas.horizonos/sdk"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Target Horizon OS SDK. v69 covers Quest 2/3/Pro on current system software. -->
    <horizonos:uses-horizonos-sdk
        horizonos:minSdkVersion="69"
        horizonos:targetSdkVersion="69" />

    <!-- 6DoF head tracking is required for an immersive experience. -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="true" />

    <!-- Spatial SDK renders with OpenGL ES 3.1. -->
    <uses-feature android:glEsVersion="0x00030001" android:required="true" />

    <application>

        <!-- Restrict to Quest devices that can run the Spatial SDK. -->
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest2|quest3|questpro" />

        <!-- Keep our activities running (focus-aware) when a system overlay appears. -->
        <meta-data
            android:name="com.oculus.vr.focusaware"
            android:value="true" />

        <!-- Required native library for Meta Spatial SDK rendering/runtime. -->
        <uses-native-library
            android:name="libossdk.oculus.so"
            android:required="true" />

        <!--
          The immersive streaming activity. It reads the SAME intent extras as
          com.limelight.Game (Game.EXTRA_HOST, EXTRA_APP_ID, ...) so ServerHelper's
          intent construction is unchanged. It is NOT a LAUNCHER: the app opens the
          normal 2D UI first; this activity starts only when a stream is launched.

          The 'com.oculus.intent.category.VR' category marks it immersive so Horizon
          OS switches into the VR compositor when it's foregrounded.
        -->
        <activity
            android:name="com.limelight.vr.VrGameActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode|density"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>

    </application>

</manifest>
